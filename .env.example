# Database
DATABASE_URL=postgresql+asyncpg://<username>:<password>@postgres:5432/<database_name>

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
SECRET_KEY=<your-secret-key>
ACCESS_TOKEN_EXPIRE_HOURS=8

# ChromaDB
# CHROMADB_HOST is the Docker service name — backend talks to it on port 8000 (internal)
# On your host machine, ChromaDB is reachable on localhost:8001 (docker-compose port mapping)
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# Ollama (runs on host machine, not in Docker)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=mistral

# File storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50